# Copy to .env (never commit .env). `npm start` reads it automatically.

# Stripe: Developers > API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=
# Stripe: Developers > Webhooks > your endpoint > Signing secret (whsec_...).
# Locally, `stripe listen --forward-to localhost:3000/api/webhooks/payments` prints one.
STRIPE_WEBHOOK_SECRET=
# Stripe: Product catalogue > your recurring prices (price_...).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Signs the login cookie. Any long random string; changing it signs everyone out.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Restore-access emails (same Resend account as VibeCheckMate is fine).
# EMAIL_API_KEY=re_...
# EMAIL_FROM=WorkSQL <login@worksql.com>

# Launch day
# The inbox shown on /support. Check it all day.
# SUPPORT_EMAIL=help@worksql.com
# Opens /admin (health, daily counts, the status line). Any long random string.
# ADMIN_TOKEN=
# Shown on pricing and the paywall. Make the promotion code itself in Stripe first.
# LAUNCH_CODE=PRODUCTHUNT
# LAUNCH_OFFER=20% off your first month
# LAUNCH_ENDS=Sunday
# Daily copies of ./data. Point this at another disk or a synced folder.
# BACKUP_DIR=/mnt/backups/worksql
# Emergency banner without /admin (overrides it).
# STATUS_MESSAGE=

# Production only
# SITE_URL=https://worksql.com
# NODE_ENV=production
