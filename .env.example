# Copy to .env (never commit .env). `npm start` reads it automatically.

# Stripe: Developers > API keys. Use sk_test_... until you go live.
STRIPE_SECRET_KEY=
# Stripe: Developers > Webhooks > your endpoint > Signing secret (whsec_...).
# Locally, `stripe listen --forward-to localhost:3000/api/webhooks/payments` prints one.
STRIPE_WEBHOOK_SECRET=
# Stripe: Product catalogue > your recurring prices (price_...).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Signs the login cookie. Any long random string; changing it signs everyone out.
# e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Production only
# SITE_URL=https://worksql.co.uk
# NODE_ENV=production
